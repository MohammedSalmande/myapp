DOMAIN=tasks.example.com

MYSQL_DATABASE=taskmanager
MYSQL_USER=taskuser
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MS=86400000

OAUTH_GOOGLE_CLIENT_ID=replace-with-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
